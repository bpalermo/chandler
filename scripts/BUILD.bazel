load("@rules_shell//shell:sh_library.bzl", "sh_library")

# Read by //bazel/cosign:verify_image, which runs the verifier with the pinned
# cosign. registry.sh parses //bazel:registry.bzl from the checkout, not from
# runfiles, so the verifier takes its expected layout from the environment
# there (see verify_image.sh).
#
# chart-pin.sh is run by //charts/stevedore:pin_test and by the publish
# workflow, so both read a chart's image pins the same way.
exports_files([
    "chart-pin.sh",
    "registry-lib.sh",
    "verify-image-signatures.sh",
])

# Nothing depends on this: it is how the scripts, most of which only people
# and workflows run, are seen by the shellcheck aspect (--config=lint).
sh_library(
    name = "scripts",
    srcs = glob(["*.sh"]),
)
