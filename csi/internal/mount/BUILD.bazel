load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "mount",
    srcs = [
        "mount.go",
        "mount_linux.go",
    ],
    importpath = "github.com/bpalermo/chandler/csi/internal/mount",
    visibility = ["//csi:__subpackages__"],
    deps = select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "mount_test",
    srcs = ["mount_test.go"],
    embed = [":mount"],
)
