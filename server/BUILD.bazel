load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel:registry.bzl", "IMAGE_REGISTRY", "image_repository")
load("//bazel/image:defs.bzl", "go_image")

go_library(
    name = "server_lib",
    srcs = ["main.go"],
    importpath = "github.com/bpalermo/chandler/server",
    visibility = ["//visibility:private"],
    deps = [
        "//api/chandler/v1:chandler",
        "//common/bundle",
        "//common/version",
        "//server/internal/hub",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//health",
        "@org_golang_google_grpc//health/grpc_health_v1",
    ],
)

go_binary(
    name = "server",
    basename = "chandler-server",
    embed = [":server_lib"],
    # Pure Go: the image binary is cross-built for linux with cgo off.
    pure = "on",
    visibility = ["//visibility:public"],
)

go_image(
    name = "image",
    base = "@distroless_static",
    binary = ":server",
    load_tag = "localhost/chandler-server:e2e",
    path = "/chandler-server",
    registry = IMAGE_REGISTRY,
    repository = image_repository("server"),
)
