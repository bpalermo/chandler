load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_buf//buf:defs.bzl", "buf_lint_test")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

proto_library(
    name = "chandlerv1_proto",
    srcs = [
        "app.proto",
        "common.proto",
        "discovery.proto",
        "peer.proto",
        "provider.proto",
    ],
    strip_import_prefix = "/api",
    visibility = ["//visibility:public"],
    deps = [
        "@googleapis//google/api:annotations_proto",
        "@googleapis//google/rpc:status_proto",
        "@protobuf//:duration_proto",
        "@protobuf//:timestamp_proto",
    ],
)

go_proto_library(
    name = "chandlerv1_go_proto",
    compilers = [
        "@rules_go//proto:go_proto",
        "@rules_go//proto:go_grpc_v2",
        "@grpc_ecosystem_grpc_gateway//protoc-gen-grpc-gateway:go_gen_grpc_gateway_opaque",
    ],
    importpath = "github.com/bpalermo/chandler/api/chandler/v1",
    proto = ":chandlerv1_proto",
    visibility = ["//visibility:public"],
    deps = [
        "@org_golang_google_genproto_googleapis_api//annotations",
        "@org_golang_google_genproto_googleapis_rpc//status",
    ],
)

go_library(
    name = "chandler",
    embed = [":chandlerv1_go_proto"],
    importpath = "github.com/bpalermo/chandler/api/chandler/v1",
    visibility = ["//visibility:public"],
)

buf_lint_test(
    name = "chandlerv1_proto_lint_test",
    size = "small",
    config = "//api:buf.yaml",
    targets = [":chandlerv1_proto"],
)
