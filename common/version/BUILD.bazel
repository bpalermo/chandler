load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "version",
    srcs = ["version.go"],
    importpath = "github.com/bpalermo/stevedore/common/version",
    visibility = ["//visibility:public"],
    # Every binary linking this package gets the version of the commit it is
    # built from. Stamping is on by default (.bazelrc), so a binary links
    # again on every commit; nothing else rebuilds.
    x_defs = {"Version": "{STABLE_GIT_VERSION}"},
)

go_test(
    name = "version_test",
    srcs = ["version_test.go"],
    embed = [":version"],
)
