common --enable_platform_specific_config
build --incompatible_strict_action_env

# Image tags and the chart's version carry the git commit; this is where it
# comes from. The script never fails, so it cannot break a build.
build --workspace_status_command=bazel/workspace_status.sh

# Stamp by default, so that a chart or a binary built anywhere says which
# commit or release it is: the chart's versions (//charts/stevedore:chart_yaml),
# the image push's tags and the binaries' version (//common/version) come from
# the workspace status. Every binary links again on each commit; nothing else
# rebuilds. A `--nostamp` build is still a valid chart, versioned
# 0.0.0-dev.unstamped, which the publish workflow refuses to push.
build --stamp
test --test_output=errors
# The end-to-end suite needs a kind cluster, so it is tagged e2e and excluded
# from `bazel test //...`; `--config=e2e` selects it instead, forwards the
# kubeconfig and never caches a result. Run it through e2e/run.sh.
test --test_tag_filters=-e2e
test:e2e --test_tag_filters=e2e
test:e2e --nocache_test_results
test:e2e --test_env=KUBECONFIG
test:e2e --test_env=PATH
test:e2e --test_timeout=1500

# rules_lint reports its use to Aspect unless told not to.
common --repo_env=ASPECT_TOOLS_TELEMETRY=-all

# The linters that run as aspects (bazel/lint/linters.bzl). Alone,
# `--config=lint` only reports; with fail_on_violation, as in CI, a finding
# fails the build.
build:lint --aspects=//bazel/lint:linters.bzl%shellcheck

# CI: the lockfile must already be up to date, and a lint finding fails.
common:ci --lockfile_mode=error
build:ci --config=lint
build:ci --@aspect_rules_lint//lint:fail_on_violation

try-import %workspace%/user.bazelrc
