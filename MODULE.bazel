module(
    name = "stevedore",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.64.2")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_img", version = "0.3.23")
bazel_dep(name = "rules_helm", version = "0.34.0")

# Named by //bazel/image for string_flag, and already in the graph through
# rules_img and rules_go; declared so a bump of those cannot drop it.
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# sh_binary and sh_test for the tool wrappers in //bazel/cosign. Already in the
# graph through rules_go and rules_helm, and at 0.8.0 through grpc-gateway.
bazel_dep(name = "rules_shell", version = "0.8.0")

# The cosign CLI -- only the CLI. @rules_img_signer_cosign//cosign is the
# official prebuilt release binary, selected per platform, with its sha256
# pinned in the module's own lock (v3.1.2 at 0.0.1). //bazel/cosign wraps it so
# the publish workflow and a workstation run the same checksummed cosign;
# bumping cosign is bumping this bazel_dep (and EXPECTED in
# //bazel/cosign:version_test). The module's signer plugin for `img deploy` is
# not used: publishing keeps image_push and a separate `cosign sign`.
bazel_dep(name = "rules_img_signer_cosign", version = "0.0.1")

# grpc-gateway, for the HTTP side of the application API: its generator
# (go_gen_grpc_gateway_opaque, used by //api/stevedore/v1) and the runtime the
# generated code calls. Gazelle uses this module in place of the Go module of
# the same name, so the version here and the one in go.mod have to agree.
#
# The registry has no 2.31 yet, and go.mod cannot go lower: the OpenTelemetry
# exporter needs 2.30 or later. So the release is fetched from GitHub. Upstream
# declares version 0.0.0, which the registry rewrites when it publishes;
# patch_cmds does the same here, or Gazelle reports the two versions as
# different on every build. Once the registry has this version or a later one,
# delete the archive_override.
bazel_dep(name = "grpc_ecosystem_grpc_gateway", version = "2.31.0")
archive_override(
    module_name = "grpc_ecosystem_grpc_gateway",
    integrity = "sha256-GTr3a+olksw4vzys15Pz+a6EXDHC1deruIKjBjWRbk4=",
    patch_cmds = ["sed -i 's/version = \"0.0.0\"/version = \"2.31.0\"/' MODULE.bazel"],
    strip_prefix = "grpc-gateway-2.31.0",
    urls = ["https://github.com/grpc-ecosystem/grpc-gateway/archive/refs/tags/v2.31.0.tar.gz"],
)

bazel_dep(name = "googleapis", version = "0.0.0-20260929-28769825")

# buf lints the protos and checks them for breaking changes (//api/stevedore/v1
# and scripts/proto-breaking.sh). Only its checks are used: protoc still
# compiles, and rules_go still generates.
bazel_dep(name = "rules_buf", version = "0.5.4")

# Formatting and the linters that are not part of compiling: //bazel/format
# formats and checks Starlark (buildifier, with its lint warnings), Go, shell
# and protos; //bazel/lint has the shellcheck aspect.
bazel_dep(name = "aspect_rules_lint", version = "2.9.1")
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")

buf = use_extension("@rules_buf//buf:extensions.bzl", "buf")
buf.toolchains(
    sha256 = "18f603d3b418f6a1259da4425b04bbe2fbaf60c2b796b98114d961e8736198b9",
    version = "v1.73.0",
)
use_repo(buf, "rules_buf_toolchains")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

# Static analysis, run as part of compiling every Go package of this module
# (and of none of its dependencies): a finding fails the build. //:nogo says
# which analyzers.
go_sdk.nogo(nogo = "//:nogo")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "co_honnef_go_tools", "com_github_aws_aws_sdk_go_v2", "com_github_aws_aws_sdk_go_v2_config", "com_github_aws_aws_sdk_go_v2_service_s3", "com_github_aws_smithy_go", "com_github_container_storage_interface_spec", "com_github_spiffe_go_spiffe_v2", "in_yaml_go_yaml_v3", "io_opentelemetry_go_otel", "io_opentelemetry_go_otel_exporters_otlp_otlpmetric_otlpmetricgrpc", "io_opentelemetry_go_otel_metric", "io_opentelemetry_go_otel_sdk", "io_opentelemetry_go_otel_sdk_metric", "org_golang_google_genproto_googleapis_api", "org_golang_google_genproto_googleapis_rpc", "org_golang_google_grpc", "org_golang_google_grpc_cmd_protoc_gen_go_grpc", "org_golang_google_protobuf", "org_golang_x_sys", "org_golang_x_tools")

# Container image base: distroless static on Debian 13, nonroot variant (user
# 65532), pinned by index digest so a moving tag cannot change the image.
# Resolved from gcr.io/distroless/static-debian13:nonroot. Layers are fetched
# lazily, only when an image is loaded, so `bazel build //...` needs no
# registry access and no Docker daemon.
pull = use_repo_rule("@rules_img//img:pull.bzl", "pull")

pull(
    name = "distroless_static",
    digest = "sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3",
    layer_handling = "lazy",
    registry = "gcr.io",
    repository = "distroless/static-debian13",
)

# Helm's own binary, so the chart is packaged, linted and installed with a
# pinned toolchain rather than whatever is on a developer's PATH.
helm = use_extension("@rules_helm//helm:extensions.bzl", "helm")
helm.host_tools()
use_repo(helm, "helm", "helm_toolchains")

register_toolchains("@helm_toolchains//:all")
