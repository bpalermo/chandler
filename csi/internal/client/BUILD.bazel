load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "client",
    srcs = ["client.go"],
    importpath = "github.com/bpalermo/chandler/csi/internal/client",
    visibility = ["//csi:__subpackages__"],
    deps = [
        "//api/chandler/v1:chandler",
        "//common/queue",
        "@org_golang_google_genproto_googleapis_rpc//status",
