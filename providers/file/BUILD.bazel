load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel:registry.bzl", "IMAGE_REGISTRY", "image_repository")
load("//bazel/image:defs.bzl", "go_image")

go_library(
    name = "file_lib",
    srcs = ["main.go"],
    importpath = "github.com/bpalermo/stevedore/providers/file",
    visibility = ["//visibility:private"],
    deps = [
        "//api/stevedore/v1:stevedore",
        "//common/provider",
        "//common/rollout",
        "//common/telemetry",
        "//common/transport",
        "//common/version",
        "//providers/file/internal/source",
        "@org_golang_google_grpc//:grpc",
    ],
)

go_binary(
    name = "file",
    basename = "stevedore-provider-file",
    embed = [":file_lib"],
    # Pure Go: the image binary is cross-built for linux with cgo off.
    pure = "on",
    visibility = ["//visibility:public"],
)

go_image(
    name = "image",
    base = "@distroless_static",
    binary = ":file",
    load_tag = "localhost/stevedore-provider-file:e2e",
    path = "/stevedore-provider-file",
    registry = IMAGE_REGISTRY,
    repository = image_repository("provider-file"),
)
