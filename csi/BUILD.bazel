load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel:registry.bzl", "IMAGE_REGISTRY", "image_repository")
load("//bazel/image:defs.bzl", "go_image")

go_library(
    name = "csi_lib",
    srcs = ["main.go"],
    importpath = "github.com/bpalermo/stevedore/csi",
    visibility = ["//visibility:private"],
    deps = [
        "//common/telemetry",
        "//common/transport",
        "//common/version",
        "//csi/internal/cache",
        "//csi/internal/client",
        "//csi/internal/driver",
        "//csi/internal/events",
        "//csi/internal/mount",
        "@com_github_container_storage_interface_spec//lib/go/csi",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials",
    ],
)

go_binary(
    name = "csi",
    basename = "stevedore-csi",
    embed = [":csi_lib"],
    # Pure Go: the image binary is cross-built for linux with cgo off.
    pure = "on",
    visibility = ["//visibility:public"],
)

go_image(
    name = "image",
    base = "@distroless_static",
    binary = ":csi",
    load_tag = "localhost/stevedore-csi:e2e",
    path = "/stevedore-csi",
    registry = IMAGE_REGISTRY,
    repository = image_repository("csi"),
    # Mounts into kubelet pod directories from a privileged DaemonSet.
    user = "0",
)
