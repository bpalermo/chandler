load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "server_lib",
    srcs = ["main.go"],
    importpath = "github.com/bpalermo/chandler/server",
    visibility = ["//visibility:private"],
    deps = [
        "//api/chandler/v1:chandler",
        "//common/version",
    ],
)

go_binary(
    name = "server",
    basename = "chandler-server",
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)
