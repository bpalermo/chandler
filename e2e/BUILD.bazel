load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "e2e_test",
    srcs = [
        "appack_test.go",
        "cache_test.go",
        "csi_test.go",
        "images_test.go",
        "kubectl_test.go",
        "s3_test.go",
        "telemetry_test.go",
        "tls_test.go",
    ],
    # Needs a cluster and kubectl: excluded from `bazel test //...` by the e2e
    # tag (see .bazelrc) and run unsandboxed by e2e/run.sh.
    tags = [
        "e2e",
        "local",
    ],
    deps = [
        "//api/chandler/v1:chandler",
        "//common/bundle",
        "//common/rollout",
        "@org_golang_google_protobuf//proto",
    ],
)
