load("@rules_helm//helm:defs.bzl", "helm_chart", "helm_lint_test", "helm_template_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:registry.bzl", "chart_push_url", "chart_registry_url", "image_reference")

# The chart package, built with the pinned helm toolchain:
# bazel-bin/charts/chandler/chandler.tgz.
#
# `images` pins the digest of each component's image_push into values.yaml at
# package time ({@//csi:image_push.digest}), so the chart and the images it
# names cannot drift. It also derives each default repository from the push
# target ({@//csi:image_push.repository}), which takes it from
# bazel/registry.bzl.
#
# Published by :chandler.push_registry: plain `helm push` of the package to
# chart_push_url() lands it in chart_registry_url("chandler"), since helm
# appends the chart's `name:` and the chart is named after its repository. Run
# it with HELM_REGISTRY_USERNAME and HELM_REGISTRY_PASSWORD set (rules_helm
# logs in with them), after the image it pins has been pushed and signed. Never
# use :chandler.push, which pushes the images too.
# The components whose images the chart deploys, as bazel/registry.bzl names
# them. Keep in step with `images` below.
PINNED_COMPONENTS = [
    "csi",
    "provider-file",
    "provider-s3",
    "server",
]

helm_chart(
    name = "chandler",
    chart = "Chart.yaml",
    images = [
        "//csi:image_push",
        "//providers/file:image_push",
        "//providers/s3:image_push",
        "//server:image_push",
    ],
    registry_url = chart_push_url(),
    templates = glob(["templates/**"]),
    values = "values.yaml",
    visibility = ["//visibility:public"],
)

helm_lint_test(
    name = "chandler_lint_test",
    size = "small",
    chart = ":chandler",
)

helm_template_test(
    name = "chandler_template_test",
    size = "small",
    chart = ":chandler",
)

# Every non-default knob: kubeletDir, stateDir, image.digest, nodeSelector,
# resources, imagePullSecrets.
helm_template_test(
    name = "chandler_overrides_template_test",
    size = "small",
    chart = ":chandler",
    values = ["test/overrides.yaml"],
)

helm_lint_test(
    name = "chandler_overrides_lint_test",
    size = "small",
    chart = ":chandler",
    values = ["test/overrides.yaml"],
)

# The chart packs the pins the way the publish workflow relies on: every
# component's repository is exactly bazel/registry.bzl's and is followed by a
# sha256 digest, and the version is a snapshot (stamped with the commit time
# and commit, or with rules_helm's placeholder in a --nostamp build).
sh_test(
    name = "pin_test",
    size = "small",
    srcs = ["pin_test.sh"],
    data = [
        ":chandler",
        "//scripts:chart-pin.sh",
    ],
    env = {
        "CHART_RLOCATIONPATH": "$(rlocationpath :chandler)",
        "CHART_PIN_RLOCATIONPATH": "$(rlocationpath //scripts:chart-pin.sh)",
        "EXPECT_REPOSITORIES": " ".join([image_reference(c) for c in PINNED_COMPONENTS]),
        "EXPECT_CHART_REPOSITORY": chart_registry_url("chandler"),
    },
    deps = ["@bazel_tools//tools/bash/runfiles"],
)
