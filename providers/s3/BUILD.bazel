load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel:registry.bzl", "IMAGE_REGISTRY", "image_repository")
load("//bazel/image:defs.bzl", "go_image")

go_library(
    name = "s3_lib",
    srcs = ["main.go"],
    importpath = "github.com/bpalermo/stevedore/providers/s3",
    visibility = ["//visibility:private"],
    deps = [
        "//api/stevedore/v1:stevedore",
        "//common/provider",
        "//common/rollout",
        "//common/telemetry",
        "//common/transport",
        "//common/version",
        "//providers/s3/internal/origin",
        "@com_github_aws_aws_sdk_go_v2_config//:config",
        "@com_github_aws_aws_sdk_go_v2_service_s3//:s3",
        "@org_golang_google_grpc//:grpc",
    ],
)

go_binary(
    name = "s3",
    basename = "stevedore-provider-s3",
    embed = [":s3_lib"],
    # Pure Go: the image binary is cross-built for linux with cgo off.
    pure = "on",
    visibility = ["//visibility:public"],
)

go_image(
    name = "image",
    base = "@distroless_static",
    binary = ":s3",
    load_tag = "localhost/stevedore-provider-s3:e2e",
    path = "/stevedore-provider-s3",
    registry = IMAGE_REGISTRY,
    repository = image_repository("provider-s3"),
)
