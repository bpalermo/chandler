load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "origin",
    srcs = ["origin.go"],
    importpath = "github.com/bpalermo/stevedore/providers/s3/internal/origin",
    visibility = ["//providers/s3:__subpackages__"],
    deps = [
        "//api/stevedore/v1:stevedore",
        "//common/bundle",
        "//common/provider",
        "//common/rollout",
        "//common/uri",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_service_s3//:s3",
        "@com_github_aws_smithy_go//:smithy-go",
        "@com_github_aws_smithy_go//transport/http",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/durationpb",
    ],
)

go_test(
    name = "origin_test",
    srcs = ["origin_test.go"],
    embed = [":origin"],
    deps = [
        "//common/bundle",
        "//common/provider",
        "//common/rollout",
        "//common/uri",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_service_s3//:s3",
        "@com_github_aws_aws_sdk_go_v2_service_s3//types",
        "@com_github_aws_smithy_go//:smithy-go",
    ],
